# Normalización global: git guarda todo en LF y normaliza el working tree.
# Las reglas específicas de abajo OVERRIDEAN esto (van después a propósito).
* text=auto eol=lf

# Artefactos JSON regenerados por el scheduler diario en Windows (CRLF).
# `text` hace que git normalice EOL al comparar/commitear → el re-write CRLF
# del builder no ensucia el working tree (el repo guarda LF).
data/catalyst/*.json text eol=lf

# Batch files DEBEN ser CRLF: cmd.exe parsea mal los .bat con LF-only
# (se come caracteres al inicio de línea y el script muere en silencio).
*.bat text eol=crlf
*.cmd text eol=crlf
